# ---- Database (PostgreSQL) ----
# ตั้ง DATABASE_URL เต็มๆ ก็ได้ หรือแยกเป็นราย field ด้านล่าง
# ถ้าไม่ตั้งอะไรเลย backend จะใช้ค่า default: localhost/postgres/iconfirm:5432
# DATABASE_URL=host=localhost user=postgres password=Kobelco.com dbname=iconfirm port=5432 sslmode=disable
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=Kobelco.com
DB_NAME=iconfirm
DB_PORT=5432
DB_SSLMODE=disable

# ---- Server ----
PORT=8080

# ---- HTTPS (ไม่บังคับ) ----
# ตั้งทั้งสองค่าคู่กันเพื่อให้ backend เสิร์ฟเป็น HTTPS แทน HTTP
# ไม่ตั้ง = เสิร์ฟเป็น HTTP ตามเดิม
# ถ้ามี reverse proxy (nginx / Caddy / F5) ทำ TLS ให้อยู่แล้ว ไม่ต้องตั้งตรงนี้
# TLS_CERT_FILE=certs/iconfirm.crt
# TLS_KEY_FILE=certs/iconfirm.key

# ---- Auth ----
# ควรตั้งค่า secret ของตัวเองใน production
JWT_SECRET=iconfirm-secret-key

# ---- CORS ----
# รายชื่อ origin ของ frontend ที่อนุญาตให้เรียก API ได้ คั่นด้วยจุลภาค
# ถ้าไม่ตั้งจะ fallback เป็น origin dev บนเครื่อง (localhost:9004 / :5173) เท่านั้น
# ALLOWED_ORIGINS=https://iconfirm.kobelco.internal,https://iconfirm-staging.kobelco.internal

# ---- รูปถ่ายป้าย IT Controller (หน้า WH) ----
# เวอร์ชันนี้ "ถ่ายเก็บอย่างเดียว" ไม่มีการเรียก AI อ่าน/เทียบค่า จึงไม่ต้องตั้ง API key ใดๆ
# (ถ้าในอนาคตอยากเปิด OCR อ่านป้ายอัตโนมัติอีกครั้ง ค่อยเพิ่ม GEMINI_API_KEY กลับมา)

# ===========================================================================
# ---- อีเมลแจ้งเตือนใบอนุญาตรายสัปดาห์ (Weekly Alert → Outlook / Microsoft 365) ----
# ===========================================================================
# ระบบจะสรุปใบอนุญาตนำเข้า–นำออกที่ "หมดอายุแล้ว / ใกล้หมดอายุ / ถึงกำหนดยื่น กสทช."
# แล้วส่งอีเมลออกเองทุกสัปดาห์ตามเวลาที่ตั้งไว้ โดยไม่ต้องเปิดหน้าเว็บทิ้งไว้
# ดูรายละเอียดการตั้งค่าทั้งหมดได้ที่ backend/WEEKLY_ALERT.md

# เปิด/ปิดการแจ้งเตือน
WEEKLY_ALERT_ENABLED=true

# ผู้รับ — ใส่ได้หลายคน คั่นด้วยจุลภาค
WEEKLY_ALERT_TO=theeparat.metheepooriwat@kobelco.com
# WEEKLY_ALERT_CC=
# WEEKLY_ALERT_BCC=

# รอบส่ง — วัน (SUN/MON/TUE/WED/THU/FRI/SAT) และเวลาแบบ 24 ชั่วโมง
WEEKLY_ALERT_DAY=MON
WEEKLY_ALERT_TIME=08:30
WEEKLY_ALERT_TZ=Asia/Bangkok

# ชื่อผู้รับที่พิมพ์หลังคำว่า "เรียน" ในหนังสือ (ไม่ต้องใส่คำว่า เรียน ซ้ำ)
WEEKLY_ALERT_GREETING=คุณธีปรัชญ์ เมธีภูริวัจน์

# หัวจดหมาย — ชื่อบริษัทและหน่วยงานที่ออกหนังสือ ตรวจให้ตรงกับชื่อนิติบุคคลจริงก่อนใช้งาน
WEEKLY_ALERT_ORG=Kobelco Construction Machinery Southeast Asia Co., Ltd.
WEEKLY_ALERT_DEPT=แผนกโลจิสติกส์

# โลโก้บนหัวจดหมาย — เส้นทางไฟล์เทียบกับโฟลเดอร์ที่รัน backend
# เว้นว่างไว้ = ไม่ใส่โลโก้ ใช้ชื่อบริษัทเป็นหัวจดหมายแทน
WEEKLY_ALERT_LOGO=assets/kobelco-logo.png
WEEKLY_ALERT_LOGO_WIDTH=190

# เกณฑ์แจ้งเตือน — ต้องตรงกับที่ใช้บนหน้าเว็บ
WEEKLY_ALERT_IMPORT_WITHIN_DAYS=30
WEEKLY_ALERT_EXPORT_WITHIN_DAYS=7

# ส่งอีเมลไหมถ้าสัปดาห์นั้นไม่มีรายการต้องดำเนินการเลย
WEEKLY_ALERT_SEND_WHEN_EMPTY=true

# ถ้าเซิร์ฟเวอร์ดับคร่อมเวลาส่ง ให้ส่งย้อนหลังทันทีที่เปิดเครื่อง (ภายในสัปดาห์เดียวกัน)
WEEKLY_ALERT_CATCH_UP=true

# เขียนและส่งอีเมลทันทีตอนเปิด backend ถ้าสัปดาห์นั้นยังไม่ได้ส่ง
# ยังคุมที่สัปดาห์ละ 1 ฉบับ — รีสตาร์ทซ้ำในสัปดาห์เดิมจะไม่ส่งอีก
WEEKLY_ALERT_SEND_ON_START=true

# ข้ามตัวกันส่งซ้ำ แล้วส่งใหม่ทุกครั้งที่รีสตาร์ท
# ใช้ตอนแก้เนื้อจดหมายแล้วอยากดูผลซ้ำ ๆ — ห้ามเปิดค้างไว้ตอนใช้งานจริง
WEEKLY_ALERT_FORCE_SEND_ON_START=false

# เพิ่มผู้รับใหม่จากหน้า Admin แล้วส่งรายงานฉบับล่าสุดให้คนนั้นทันที (ส่งถึงคนนั้นคนเดียว ไม่มี CC/BCC)
# ไม่นับเป็นรอบประจำสัปดาห์ — วันจันทร์ถัดไปคนนี้ก็ยังได้รับพร้อมทุกคนตามปกติ
WEEKLY_ALERT_SEND_ON_ADD=true

# แนบไฟล์ CSV รายการทั้งหมดไปกับอีเมล
WEEKLY_ALERT_ATTACH_CSV=true

# รูปแบบไฟล์แนบ
# xlsx = ไฟล์ Excel มีสี หัวคอลัมน์เขียวอมฟ้า เหมือนไฟล์ที่กด Export จากในระบบ
# csv  = ไฟล์ข้อความล้วน ไม่มีสี
WEEKLY_ALERT_ATTACH_FORMAT=xlsx

# จำนวนแถวสูงสุดต่อ 1 ตารางในอีเมล ส่วนที่เกินให้ดูจากไฟล์แนบ
WEEKLY_ALERT_MAX_ROWS=25

# แสดงปี พ.ศ. แทน ค.ศ. ในหนังสือ (true = ตามแบบหนังสือไทย, false = ตรงกับที่แสดงบนหน้าเว็บ)
WEEKLY_ALERT_BUDDHIST_YEAR=true

# ลิงก์เปิดระบบจากในอีเมล — เว้นว่างไว้ถ้ายังไม่มีโดเมนจริง ปุ่มจะไม่ขึ้น
# APP_BASE_URL=https://iconfirm.kobelco.internal

# ---- ช่องทางส่ง ----
# ระบบเขียนจดหมายเองได้อยู่แล้ว แต่การ "ส่ง" ต้องผ่านเซิร์ฟเวอร์เมลเสมอ
# เลือกได้ 5 แบบ
#
# outlook = ยืม Outlook ที่ล็อกอินค้างไว้บนเครื่อง Windows เป็นคนส่ง
#         ไม่ต้องใช้รหัสผ่านและไม่ต้องขออะไรจาก IT
#         แต่ backend ต้องรันบนเครื่อง Windows เครื่องเดียวกับที่ติดตั้ง Outlook
# file  = ไม่ส่งออกนอกเครื่อง แต่เขียนจดหมายลงไฟล์ .eml + .html ให้เปิดดูได้
#         ไม่ต้องมีบัญชีเมล ไม่ต้องมีรหัสผ่าน — เหมาะกับการเทสว่าระบบเขียนอะไรออกมา
# smtp  = ส่งผ่าน SMTP (ใส่ SMTP_USERNAME/SMTP_PASSWORD ถ้าเซิร์ฟเวอร์บังคับล็อกอิน
#         เว้นว่างทั้งคู่ได้ถ้าเป็น relay ภายในองค์กรที่ยอมให้เครื่องนี้ส่งได้เลย)
# graph = ส่งผ่าน Microsoft Graph API — ไม่ใช้รหัสผ่านของคน ใช้ client id/secret ของแอปแทน
#         เหมาะกับองค์กรที่ปิด Basic Auth แล้ว ต้องให้ IT ลงทะเบียนแอปให้
# log   = เขียนสรุปบรรทัดเดียวลง log ไม่ส่งและไม่เก็บไฟล์
#
# ตั้งไว้เป็น outlook เพื่อให้ระบบเขียนและกดส่งเองผ่าน Outlook บนเครื่องนี้
# ถ้าย้ายไปรันบนเซิร์ฟเวอร์ Linux ให้เปลี่ยนเป็น smtp หรือ graph
MAIL_PROVIDER=outlook

# ---- ตั้งค่าเมื่อ MAIL_PROVIDER=outlook ----
# true = เปิดหน้าต่างร่างจดหมายให้ตรวจก่อน ไม่กดส่งเอง
# false = เขียนแล้วกดส่งให้เลย ไม่มีหน้าต่างเด้ง
MAIL_OUTLOOK_DISPLAY_ONLY=false

MAIL_FROM=iconfirm@kobelco.com
MAIL_FROM_NAME=I-CONFIRMATION System
MAIL_TIMEOUT_SECONDS=30

# ---- ตั้งค่าเมื่อ MAIL_PROVIDER=file ----
# โฟลเดอร์เก็บจดหมาย เทียบกับโฟลเดอร์ที่รัน backend
MAIL_OUT_DIR=outbox

# ---- ตั้งค่าเมื่อ MAIL_PROVIDER=smtp ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_STARTTLS=true
# smtp.office365.com บังคับล็อกอินเสมอ ต้องใส่ทั้งคู่
# ถ้ากล่องเปิด MFA ต้องใช้ App password ไม่ใช่รหัสผ่านที่ใช้ล็อกอินปกติ
SMTP_USERNAME=iconfirm@kobelco.com
SMTP_PASSWORD=
# ถ้าใช้ relay ภายในองค์กรที่ไม่ต้องล็อกอิน ให้เว้น username/password ว่างทั้งคู่
# แล้วเปลี่ยน host/port เป็นของ relay เช่น
# SMTP_HOST=relay.kobelco.internal
# SMTP_PORT=25
# SMTP_STARTTLS=false

# ---- ตั้งค่าเมื่อ MAIL_PROVIDER=graph ----
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=iconfirm@kobelco.com
