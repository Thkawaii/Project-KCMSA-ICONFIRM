# ---- Database (PostgreSQL) ----
# ตั้ง DATABASE_URL เต็มๆ ก็ได้ หรือแยกเป็นราย field ด้านล่าง
# ถ้าไม่ตั้งอะไรเลย backend จะใช้ค่า default: localhost/postgres/iconfirm:5432
# DATABASE_URL=host=localhost user=postgres password=Kobelco.com dbname=iconfirm port=5432 sslmode=disable
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=Kobelco.com
DB_NAME=iconfirm
DB_PORT=5432
DB_SSLMODE=disable

# ---- Server ----
PORT=8080

# ---- Auth ----
# ควรตั้งค่า secret ของตัวเองใน production
JWT_SECRET=iconfirm-secret-key

# ---- CORS ----
# ตอน dev ไม่ต้องตั้งค่านี้เลย — backend จับ origin ของ LAN dev อัตโนมัติ
# (localhost/127.0.0.1 + private IP ทุกวง เช่น 192.168.x.x, 10.x.x.x บนพอร์ต 9004/5173)
# ไม่ว่าจะเปลี่ยน WiFi/ฮอตสปอตกี่รอบก็ใช้ได้ทันทีโดยไม่ต้องแก้ไฟล์นี้ (ดู middleware/core.go)
#
# ตั้งค่านี้เฉพาะตอน deploy ขึ้นโดเมนจริง (production) เท่านั้น เช่น:
# ALLOWED_ORIGINS=https://iconfirm.kobelco.internal

# ---- รูปถ่ายป้าย IT Controller (หน้า WH) ----
# เวอร์ชันนี้ "ถ่ายเก็บอย่างเดียว" ไม่มีการเรียก AI อ่าน/เทียบค่า จึงไม่ต้องตั้ง API key ใดๆ
# (ถ้าในอนาคตอยากเปิด OCR อ่านป้ายอัตโนมัติอีกครั้ง ค่อยเพิ่ม GEMINI_API_KEY กลับมา)

# ---- อีเมลแจ้งเตือนใบอนุญาตรายสัปดาห์ (Weekly Alert) ----
# ระบบจะดึงข้อมูลใบอนุญาตจากฐานข้อมูลจริง เขียนเป็นอีเมล แล้วส่งเข้า Outlook เอง
# ตอนนี้ตั้งให้ยืม Outlook ที่ล็อกอินค้างไว้บนเครื่องเป็นคนส่ง จึงไม่ต้องใช้รหัสผ่าน
# รายละเอียดทั้งหมดอยู่ใน backend/WEEKLY_ALERT.md

WEEKLY_ALERT_ENABLED=true
WEEKLY_ALERT_TO=theeparat.metheepooriwat@kobelco.com
WEEKLY_ALERT_DAY=MON
WEEKLY_ALERT_TIME=08:30
WEEKLY_ALERT_TZ=Asia/Bangkok

# ชื่อผู้รับที่พิมพ์หลังคำว่า "เรียน" ในหนังสือ (ไม่ต้องใส่คำว่า เรียน ซ้ำ)
WEEKLY_ALERT_GREETING=คุณธีปรัชญ์ เมธีภูริวัจน์

# หัวจดหมาย — ชื่อบริษัทและหน่วยงานที่ออกหนังสือ ตรวจให้ตรงกับชื่อนิติบุคคลจริงก่อนใช้งาน
WEEKLY_ALERT_ORG=Kobelco Construction Machinery Southeast Asia Co., Ltd.
WEEKLY_ALERT_DEPT=แผนกโลจิสติกส์

# โลโก้บนหัวจดหมาย — เส้นทางไฟล์เทียบกับโฟลเดอร์ที่รัน backend
# เว้นว่างไว้ = ไม่ใส่โลโก้ ใช้ชื่อบริษัทเป็นหัวจดหมายแทน
WEEKLY_ALERT_LOGO=assets/kobelco-logo.png
WEEKLY_ALERT_LOGO_WIDTH=190
WEEKLY_ALERT_IMPORT_WITHIN_DAYS=30
WEEKLY_ALERT_EXPORT_WITHIN_DAYS=7
WEEKLY_ALERT_SEND_WHEN_EMPTY=true
WEEKLY_ALERT_ATTACH_CSV=true

# รูปแบบไฟล์แนบ
# xlsx = ไฟล์ Excel มีสี หัวคอลัมน์เขียวอมฟ้า เหมือนไฟล์ที่กด Export จากในระบบ
# csv  = ไฟล์ข้อความล้วน ไม่มีสี
WEEKLY_ALERT_ATTACH_FORMAT=xlsx
WEEKLY_ALERT_BUDDHIST_YEAR=true

# ---- ช่องทางส่ง ----
# outlook = ยืม Outlook บนเครื่องนี้เป็นคนส่ง ไม่ต้องใช้รหัสผ่าน (ต้องรัน backend บน Windows)
# ตัวเลือกอื่น: smtp / graph / file / log — ดู backend/WEEKLY_ALERT.md
MAIL_PROVIDER=outlook
MAIL_FROM_NAME=I-CONFIRMATION System

# true = เปิดหน้าต่างร่างจดหมายให้ตรวจก่อนแล้วกด Send เอง
# false = เขียนแล้วกดส่งให้เลย
MAIL_OUTLOOK_DISPLAY_ONLY=false

# ---- ใช้เมื่อเปลี่ยนกลับไป MAIL_PROVIDER=smtp เท่านั้น ----
# MAIL_FROM=iconfirm@kobelco.com
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=iconfirm@kobelco.com
# SMTP_PASSWORD=

# ส่งทันทีที่เปิด backend ถ้าสัปดาห์นั้นยังไม่ได้ส่ง (ยังคุมที่สัปดาห์ละ 1 ฉบับ)
WEEKLY_ALERT_SEND_ON_START=true

# true = ส่งซ้ำทุกครั้งที่รีสตาร์ท ถึงจะส่งไปแล้วในสัปดาห์นั้น
# ใช้ตอนแก้เนื้อจดหมายแล้วอยากดูผลซ้ำ ๆ — แก้เสร็จแล้วเปลี่ยนกลับเป็น false
WEEKLY_ALERT_FORCE_SEND_ON_START=true
